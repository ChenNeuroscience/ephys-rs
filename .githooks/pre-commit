#!/bin/sh
# Every commit counts the version up: v0.x, x being Cargo.toml's minor version (not semver, just a count). See
# docs/development.md. Turn on with: git config core.hooksPath .githooks
set -e
cd "$(git rev-parse --show-toplevel)"
current=$(sed -n 's/^version = "0\.\([0-9][0-9]*\)\.0"$/\1/p' Cargo.toml | head -n 1)
if [ -z "$current" ]; then
    echo "pre-commit: Cargo.toml's version isn't 0.x.0" >&2
    exit 1
fi
next=$((current + 1))
sed -i.bak "s/^version = \"0\.$current\.0\"$/version = \"0.$next.0\"/" Cargo.toml
sed -i.bak "/^name = \"ephys-rs\"$/{n;s/^version = \".*\"$/version = \"0.$next.0\"/;}" Cargo.lock
rm -f Cargo.toml.bak Cargo.lock.bak
git add Cargo.toml Cargo.lock
echo "pre-commit: version v0.$next"
